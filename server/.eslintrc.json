{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": "off",
    "import/prefer-default-export": "off",
    "import/extensions": ["error", "ignorePackages"],
    "max-len": ["warn", { "code": 110 }],
    "arrow-body-style": "off"
  }
}
